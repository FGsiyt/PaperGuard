# Local settings only. Copy to .env; never commit credentials.
PAPERGUARD_SOURCES=crossref,openalex,arxiv
PAPERGUARD_EMAIL=
PAPERGUARD_TIMEOUT=20
PAPERGUARD_CACHE_TTL=604800
# Optional absolute data directory; default: PaperGuard/data
# PAPERGUARD_DATA=C:/Research/PaperGuardData
OPENALEX_API_KEY=
# Compatible chat-completions endpoint, including /v1. Leave empty to disable.
PAPERGUARD_LLM_BASE=
PAPERGUARD_LLM_MODEL=
PAPERGUARD_LLM_KEY=
# Ollama example: http://127.0.0.1:11434/v1, model name must already be installed.
